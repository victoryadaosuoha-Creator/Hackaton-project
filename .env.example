# Public frontend variables only. Never put a service-role key, database
# password, or AI provider secret in a VITE_ variable or in browser code.
#
# Local / demonstration: leave these empty. The app enters labelled demo mode.
# Staging / production: set both values in the host's secret configuration.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
